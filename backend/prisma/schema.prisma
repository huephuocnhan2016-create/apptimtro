generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  LANDLORD
  ADMIN
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  phone        String         @unique @db.VarChar(16)
  email        String?        @unique @db.VarChar(320)
  fullName     String?        @map("full_name") @db.VarChar(120)
  avatarUrl    String?        @map("avatar_url") @db.Text
  role         UserRole       @default(STUDENT)
  isVerified   Boolean        @default(false) @map("is_verified")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshTokens RefreshToken[]
  rooms         Room[]
  favorites     Favorite[]
  conversationsAsStudent  Conversation[] @relation("studentChats")
  conversationsAsLandlord Conversation[] @relation("landlordChats")
  payments     Payment[]

  @@map("users")
}

enum RoomStatus {
  PENDING
  AVAILABLE
  FULL
  HIDDEN
}

model Room {
  id              String       @id @default(uuid()) @db.Uuid
  landlordId      String       @map("landlord_id") @db.Uuid
  title           String       @db.VarChar(160)
  description     String       @db.Text
  address         String       @db.VarChar(500)
  latitude        Float?       @db.DoublePrecision
  longitude       Float?       @db.DoublePrecision
  price           Decimal      @db.Decimal(12, 2)
  area            Float        @db.DoublePrecision
  totalRooms      Int          @map("total_rooms")
  availableRooms  Int          @map("available_rooms")
  electricityPrice Decimal     @map("electricity_price") @db.Decimal(12, 2)
  waterPrice      Decimal      @map("water_price") @db.Decimal(12, 2)
  internetPrice   Decimal      @map("internet_price") @db.Decimal(12, 2)
  deposit         Decimal      @db.Decimal(12, 2)
  status          RoomStatus   @default(AVAILABLE)
  amenities       String[]     @default([])
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  landlord        User         @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  images          RoomImage[]
  favorites       Favorite[]
  conversations   Conversation[]
  payments        Payment[]

  @@index([landlordId, createdAt])
  @@index([status, price])
  @@index([availableRooms])
  @@map("rooms")
}

model RoomImage {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  imageUrl  String   @map("image_url") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, sortOrder])
  @@map("room_images")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model Conversation {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id")  @db.Uuid
  landlordId String   @map("landlord_id") @db.Uuid
  roomId     String   @map("room_id")     @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  student   User @relation("studentChats",  fields: [studentId],  references: [id], onDelete: Cascade)
  landlord  User @relation("landlordChats", fields: [landlordId], references: [id], onDelete: Cascade)
  room      Room @relation(fields: [roomId], references: [id],    onDelete: Cascade)

  @@unique([studentId, roomId])
  @@index([studentId, createdAt])
  @@index([landlordId, createdAt])
  @@map("conversations")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  studentId     String        @map("student_id") @db.Uuid
  roomId        String        @map("room_id") @db.Uuid
  txnRef        String        @unique @map("txn_ref") @db.VarChar(64)
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  transactionNo String?       @map("transaction_no") @db.VarChar(64)
  responseCode  String?       @map("response_code") @db.VarChar(8)
  payDate       DateTime?     @map("pay_date") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([roomId, status])
  @@map("payments")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model PhoneVerification {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String    @db.VarChar(16)
  role       UserRole
  otpHash    String    @map("otp_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("phone_verifications")
}
